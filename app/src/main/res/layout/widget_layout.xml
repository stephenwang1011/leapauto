<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widgetHostRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="UseAppTint">

    <ImageView
        android:id="@+id/widgetBackgroundImg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_background_landscape_dark" />

    <LinearLayout
        android:id="@+id/widgetRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="0dp"
        android:paddingTop="4dp"
        android:paddingEnd="0dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtWTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="零跑"
            android:textColor="@color/widget_on_surface"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="start|center_vertical" />

        <TextView
            android:id="@+id/txtWUpdated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="等待同步"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="11sp"
            android:gravity="end|center_vertical"
            android:layout_marginEnd="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widgetRangeColumn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginTop="0dp"
            android:orientation="vertical">

        <LinearLayout
            android:id="@+id/widgetPureRange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtWRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:shadowColor="@color/widget_text_shadow"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="1.5"
                    android:text="--"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtWRangeUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_marginBottom="1.5dp"
                    android:includeFontPadding="false"
                    android:shadowColor="@color/widget_text_shadow"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="1.5"
                    android:text="km"
                    android:textColor="@color/widget_on_surface_variant"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtWPureSoc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_marginBottom="1.5dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="@color/widget_text_shadow"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="1.5"
                    android:text=""
                    android:textColor="@color/widget_range_good"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="start|center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="110dp"
                    android:layout_height="4.5dp">

                    <ProgressBar
                        android:id="@+id/progressWCharge"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_pure_range_progress" />

                    <ProgressBar
                        android:id="@+id/progressWChargeWarning"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_pure_range_warning_progress"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/progressWChargeCritical"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_pure_range_critical_progress"
                        android:visibility="gone" />

                </FrameLayout>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/widgetHybridRange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="增程续航"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgWElectricRangeIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="2dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_hybrid_electric"
                        android:tint="@color/energy_green" />

                    <TextView
                        android:id="@+id/txtWElectricRange"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="none"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:shadowColor="@color/widget_text_shadow"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="1.5"
                        android:text="-- km"
                        android:textColor="@color/energy_green"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="10sp"
                        android:autoSizeMaxTextSize="18sp"
                        android:autoSizeStepGranularity="1sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.9">

                        <ProgressBar
                            android:id="@+id/progressWElectric"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:indeterminate="false"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/widget_charge_progress" />

                        <ProgressBar
                            android:id="@+id/progressWElectricWarning"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:indeterminate="false"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/widget_pure_range_warning_progress"
                            android:visibility="gone" />

                        <ProgressBar
                            android:id="@+id/progressWElectricCritical"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:indeterminate="false"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/widget_pure_range_critical_progress"
                            android:visibility="gone" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.1" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgWFuelRangeIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="2dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_hybrid_fuel"
                        android:tint="@color/leap_blue" />

                    <TextView
                        android:id="@+id/txtWFuelRange"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="none"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:shadowColor="@color/widget_text_shadow"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="1.5"
                        android:text="-- km"
                        android:textColor="@color/leap_blue"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="10sp"
                        android:autoSizeMaxTextSize="18sp"
                        android:autoSizeStepGranularity="1sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.9">

                        <ProgressBar
                            android:id="@+id/progressWFuel"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:indeterminate="false"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/widget_charge_progress" />

                        <ProgressBar
                            android:id="@+id/progressWFuelWarning"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:indeterminate="false"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/widget_pure_range_warning_progress"
                            android:visibility="gone" />

                        <ProgressBar
                            android:id="@+id/progressWFuelCritical"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:indeterminate="false"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/widget_pure_range_critical_progress"
                            android:visibility="gone" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.1" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widgetStatusContainer"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgWChargingStatus"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="充电中"
                android:src="@drawable/ic_widget_charging_bolt"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtWGeneralStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="11sp"
                android:maxLines="1" />
        </LinearLayout>

        </LinearLayout>

        <ImageView
            android:id="@+id/imgWCar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widgetActionRow"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="2.5dp"
        android:clipChildren="false"
        android:gravity="center"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/spaceWActionStart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.5"
            android:visibility="gone" />

        <!-- Slot 1 -->
        <FrameLayout
            android:id="@+id/slotW1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="0dp"
            android:clipChildren="false">

            <FrameLayout
                android:id="@+id/btnBgSlot1"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_action_background">

                <ImageView
                    android:id="@+id/imgWSlot1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_phosphor_lock_open"
                    android:tint="@color/widget_action_icon" />

                <ProgressBar
                    android:id="@+id/progressWSlot1AcCooling"
                    style="@null"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:padding="8dp"
                    android:indeterminate="true"
                    android:indeterminateOnly="true"
                    android:indeterminateDrawable="@drawable/widget_ac_spinning_cooling"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/progressWSlot1AcHeating"
                    style="@null"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:padding="8dp"
                    android:indeterminate="true"
                    android:indeterminateOnly="true"
                    android:indeterminateDrawable="@drawable/widget_ac_spinning_heating"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/progressWSlot1AcVent"
                    style="@null"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:padding="8dp"
                    android:indeterminate="true"
                    android:indeterminateOnly="true"
                    android:indeterminateDrawable="@drawable/widget_ac_spinning_vent"
                    android:visibility="gone" />
            </FrameLayout>
        </FrameLayout>

        <!-- Slot 2 -->
        <FrameLayout
            android:id="@+id/slotW2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="0dp"
            android:clipChildren="false">

            <FrameLayout
                android:id="@+id/btnBgSlot2"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_action_background">

                <ImageView
                    android:id="@+id/imgWSlot2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_phosphor_lock"
                    android:tint="@color/widget_action_icon" />

                <ProgressBar
                    android:id="@+id/progressWSlot2AcCooling"
                    style="@null"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:padding="8dp"
                    android:indeterminate="true"
                    android:indeterminateOnly="true"
                    android:indeterminateDrawable="@drawable/widget_ac_spinning_cooling"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/progressWSlot2AcHeating"
                    style="@null"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:padding="8dp"
                    android:indeterminate="true"
                    android:indeterminateOnly="true"
                    android:indeterminateDrawable="@drawable/widget_ac_spinning_heating"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/progressWSlot2AcVent"
                    style="@null"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:padding="8dp"
                    android:indeterminate="true"
                    android:indeterminateOnly="true"
                    android:indeterminateDrawable="@drawable/widget_ac_spinning_vent"
                    android:visibility="gone" />
            </FrameLayout>
        </FrameLayout>

        <!-- Slot 3 -->
        <FrameLayout
            android:id="@+id/slotW3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="0dp"
            android:clipChildren="false">

            <FrameLayout
                android:id="@+id/btnBgSlot3"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_action_background">

                <ImageView
                    android:id="@+id/imgWSlot3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_sentry"
                    android:tint="@color/widget_action_icon" />

                <ProgressBar
                    android:id="@+id/progressWSlot3AcCooling"
                    style="@null"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:padding="8dp"
                    android:indeterminate="true"
                    android:indeterminateOnly="true"
                    android:indeterminateDrawable="@drawable/widget_ac_spinning_cooling"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/progressWSlot3AcHeating"
                    style="@null"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:padding="8dp"
                    android:indeterminate="true"
                    android:indeterminateOnly="true"
                    android:indeterminateDrawable="@drawable/widget_ac_spinning_heating"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/progressWSlot3AcVent"
                    style="@null"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:padding="8dp"
                    android:indeterminate="true"
                    android:indeterminateOnly="true"
                    android:indeterminateDrawable="@drawable/widget_ac_spinning_vent"
                    android:visibility="gone" />
            </FrameLayout>
        </FrameLayout>

        <!-- Slot 4 -->
        <FrameLayout
            android:id="@+id/slotW4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="0dp"
            android:clipChildren="false">

            <FrameLayout
                android:id="@+id/btnBgSlot4"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_action_background">

                <ImageView
                    android:id="@+id/imgWSlot4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_phosphor_fan"
                    android:tint="@color/widget_action_icon" />

                <ProgressBar
                    android:id="@+id/progressWSlot4AcCooling"
                    style="@null"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:padding="8dp"
                    android:indeterminate="true"
                    android:indeterminateOnly="true"
                    android:indeterminateDrawable="@drawable/widget_ac_spinning_cooling"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/progressWSlot4AcHeating"
                    style="@null"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:padding="8dp"
                    android:indeterminate="true"
                    android:indeterminateOnly="true"
                    android:indeterminateDrawable="@drawable/widget_ac_spinning_heating"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/progressWSlot4AcVent"
                    style="@null"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:padding="8dp"
                    android:indeterminate="true"
                    android:indeterminateOnly="true"
                    android:indeterminateDrawable="@drawable/widget_ac_spinning_vent"
                    android:visibility="gone" />
            </FrameLayout>
        </FrameLayout>

        <!-- Slot 5 -->
        <FrameLayout
            android:id="@+id/slotW5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="0dp"
            android:clipChildren="false">

            <FrameLayout
                android:id="@+id/btnBgSlot5"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_action_background">

                <ImageView
                    android:id="@+id/imgWSlot5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_phosphor_trunk_open"
                    android:tint="@color/widget_action_icon" />

                <ProgressBar
                    android:id="@+id/progressWSlot5AcCooling"
                    style="@null"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:padding="8dp"
                    android:indeterminate="true"
                    android:indeterminateOnly="true"
                    android:indeterminateDrawable="@drawable/widget_ac_spinning_cooling"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/progressWSlot5AcHeating"
                    style="@null"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:padding="8dp"
                    android:indeterminate="true"
                    android:indeterminateOnly="true"
                    android:indeterminateDrawable="@drawable/widget_ac_spinning_heating"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/progressWSlot5AcVent"
                    style="@null"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:padding="8dp"
                    android:indeterminate="true"
                    android:indeterminateOnly="true"
                    android:indeterminateDrawable="@drawable/widget_ac_spinning_vent"
                    android:visibility="gone" />
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/spaceWActionEnd"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.5"
            android:visibility="gone" />
    </LinearLayout>
    </LinearLayout>
</FrameLayout>
