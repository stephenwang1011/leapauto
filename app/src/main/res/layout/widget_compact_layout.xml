<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="UseAppTint,UselessParent">

    <LinearLayout
        android:id="@+id/compactWidgetRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card_background"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="21dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtWCTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:maxLines="1"
                android:text="@string/widget_default_title"
                android:textColor="@color/widget_on_surface"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/compactRangeContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            tools:ignore="NestedWeights">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtWCSocValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="@color/widget_text_shadow"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="1.5"
                    android:text="@string/widget_unknown_value"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/txtWCSocUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginTop="8dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="@color/widget_text_shadow"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="1.5"
                    android:text="@string/widget_percent_symbol"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtWCRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/widget_text_shadow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="1.5"
                android:text="@string/widget_unknown_range"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/compactHybridRange"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="2dp"
            android:layout_weight="1"
            android:gravity="top"
            android:orientation="vertical"
            android:visibility="gone"
            tools:ignore="NestedWeights">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:baselineAligned="false"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="1dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imgWCElectricIcon"
                            android:layout_width="12dp"
                            android:layout_height="14dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_hybrid_electric"
                            android:tint="@color/widget_range_good" />

                        <TextView
                            android:id="@+id/txtWCElectricRange"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:shadowColor="@color/widget_text_shadow"
                            android:shadowDx="0"
                            android:shadowDy="0"
                            android:shadowRadius="1.5"
                            android:text="--km"
                            android:textColor="@color/widget_range_good"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtWCElectricSoc"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="1dp"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:shadowColor="@color/widget_text_shadow"
                            android:shadowDx="0"
                            android:shadowDy="0"
                            android:shadowRadius="1.5"
                            android:text="--%"
                            android:textColor="@color/widget_range_good"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginTop="1dp">

                        <ProgressBar
                            android:id="@+id/progressWCElectric"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:indeterminate="false"
                            android:max="100"
                            android:progressDrawable="@drawable/widget_pure_range_progress" />

                        <ProgressBar
                            android:id="@+id/progressWCElectricWarning"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:indeterminate="false"
                            android:max="100"
                            android:progressDrawable="@drawable/widget_pure_range_warning_progress"
                            android:visibility="gone" />

                        <ProgressBar
                            android:id="@+id/progressWCElectricCritical"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:indeterminate="false"
                            android:max="100"
                            android:progressDrawable="@drawable/widget_pure_range_critical_progress"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imgWCFuelIcon"
                            android:layout_width="12dp"
                            android:layout_height="14dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_hybrid_fuel"
                            android:tint="@color/widget_range_warning" />

                        <TextView
                            android:id="@+id/txtWCFuelRange"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:shadowColor="@color/widget_text_shadow"
                            android:shadowDx="0"
                            android:shadowDy="0"
                            android:shadowRadius="1.5"
                            android:text="--km"
                            android:textColor="@color/widget_range_warning"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtWCFuelSoc"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="1dp"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:shadowColor="@color/widget_text_shadow"
                            android:shadowDx="0"
                            android:shadowDy="0"
                            android:shadowRadius="1.5"
                            android:text="--%"
                            android:textColor="@color/widget_range_warning"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginTop="1dp">

                        <ProgressBar
                            android:id="@+id/progressWCFuel"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:indeterminate="false"
                            android:max="100"
                            android:progressDrawable="@drawable/widget_compact_fuel_range_progress" />
                    </FrameLayout>

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/compactPureProgress"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp">

            <ProgressBar
                android:id="@+id/progressWCNormal"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_pure_range_progress" />

            <ProgressBar
                android:id="@+id/progressWCWarning"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_pure_range_warning_progress"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progressWCCritical"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_pure_range_critical_progress"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="11dp"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnWCLock"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/widget_compact_action_neutral"
                android:contentDescription="@string/widget_lock_unknown_description"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgWCLock"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_phosphor_lock"
                    android:tint="@color/widget_on_surface_variant" />

                <TextView
                    android:id="@+id/txtWCLock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_lock_label"
                    android:textColor="@color/widget_on_surface_variant"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnWCAc"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:background="@drawable/widget_compact_action_neutral"
                android:contentDescription="@string/widget_ac_unknown_description"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="22dp"
                    android:layout_height="22dp">

                    <ImageView
                        android:id="@+id/imgWCAcOff"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_phosphor_fan"
                        android:tint="@color/widget_on_surface_variant" />

                    <ImageView
                        android:id="@+id/imgWCAcOn"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:scaleX="1.15"
                        android:scaleY="1.15"
                        android:src="@drawable/ic_widget_ac_on"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/txtWCAc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_ac_label"
                    android:textColor="@color/widget_on_surface_variant"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
