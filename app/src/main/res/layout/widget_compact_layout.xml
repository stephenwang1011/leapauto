<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="UseAppTint,UselessParent">

    <LinearLayout
        android:id="@+id/compactWidgetRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card_background"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <!-- 1. 顶部栏：车辆昵称/车型 (C16) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtWCTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="@color/widget_text_shadow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="1.5"
                android:text="@string/widget_default_title"
                android:textColor="@color/widget_on_surface"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2. 上半部：精致微缩车模展厅 (C16) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp">

            <ImageView
                android:id="@+id/imgWCCar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/vehicle_lafa5_liquid_silver" />
        </FrameLayout>

        <!-- 3. 中间部：增程双能源数据（上下双行排列，纯电+燃油各占一行） -->
        <LinearLayout
            android:id="@+id/compactHybridRange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- 纯电行 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgWCElectricIcon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_hybrid_electric"
                    android:tint="@color/widget_range_good" />

                <TextView
                    android:id="@+id/txtWCElectricRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="@color/widget_text_shadow"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="1.5"
                    android:text="--km"
                    android:textColor="@color/widget_range_good"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtWCElectricSoc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="@color/widget_text_shadow"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="1.5"
                    android:text="· --%"
                    android:textColor="@color/widget_range_good"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 燃油行 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgWCFuelIcon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_hybrid_fuel"
                    android:tint="@color/widget_range_warning" />

                <TextView
                    android:id="@+id/txtWCFuelRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="@color/widget_text_shadow"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="1.5"
                    android:text="--km"
                    android:textColor="@color/widget_range_warning"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtWCFuelSoc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="@color/widget_text_shadow"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="1.5"
                    android:text="· --%"
                    android:textColor="@color/widget_range_warning"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 纯电版：居中大字或胶囊 -->
        <LinearLayout
            android:id="@+id/compactRangeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtWCRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/widget_text_shadow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="1.5"
                android:text="-- km"
                android:textColor="@color/widget_range_good"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="·"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtWCSocValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/widget_text_shadow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="1.5"
                android:text="--"
                android:textColor="@color/widget_range_good"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtWCSocUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="%"
                android:textColor="@color/widget_range_good"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 4. 底部控车按钮（车锁 + 空调） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnWCLock"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_compact_action_neutral"
                android:contentDescription="车锁"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgWCLock"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_phosphor_lock" />

                <TextView
                    android:id="@+id/txtWCLock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_lock_label"
                    android:textColor="@color/widget_on_surface_variant"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnWCAc"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:background="@drawable/widget_compact_action_neutral"
                android:clipChildren="false"
                android:contentDescription="@string/widget_ac_unknown_description"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="26dp"
                    android:layout_height="26dp">

                    <ImageView
                        android:id="@+id/imgWCAcOff"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_phosphor_fan"
                        android:tint="@color/widget_on_surface_variant" />

                    <ProgressBar
                        android:id="@+id/imgWCAcOn"
                        style="@null"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:indeterminate="true"
                        android:indeterminateOnly="true"
                        android:indeterminateDrawable="@drawable/widget_ac_spinning_cooling"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/imgWCAcOnHeating"
                        style="@null"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:indeterminate="true"
                        android:indeterminateOnly="true"
                        android:indeterminateDrawable="@drawable/widget_ac_spinning_heating"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/imgWCAcOnVent"
                        style="@null"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:indeterminate="true"
                        android:indeterminateOnly="true"
                        android:indeterminateDrawable="@drawable/widget_ac_spinning_vent"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/txtWCAc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_ac_label"
                    android:textColor="@color/widget_on_surface_variant"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
