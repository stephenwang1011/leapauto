<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#CC383838"
                android:endColor="#CC222222" />
            <stroke
                android:width="0.5dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#80404040"
                android:endColor="#80282828" />
            <stroke
                android:width="0.5dp"
                android:color="#26FFFFFF" />
        </shape>
    </item>
</selector>
