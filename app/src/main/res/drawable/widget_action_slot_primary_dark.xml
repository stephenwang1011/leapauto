<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#4D00C853" />
            <stroke android:width="0.5dp" android:color="#9900C853" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#2E00C853" />
            <stroke android:width="0.5dp" android:color="#6600C853" />
        </shape>
    </item>
</selector>
