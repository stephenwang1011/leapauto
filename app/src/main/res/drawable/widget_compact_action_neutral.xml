<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <inset android:insetLeft="4dp" android:insetTop="4dp" android:insetRight="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/widget_action_pressed" />
                <stroke android:width="0.5dp" android:color="#4DFFFFFF" />
                <corners android:radius="18dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="4dp" android:insetTop="4dp" android:insetRight="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <gradient
                    android:type="linear"
                    android:angle="315"
                    android:startColor="#80333E52"
                    android:endColor="#801D2430" />
                <stroke android:width="0.5dp" android:color="#26FFFFFF" />
                <corners android:radius="18dp" />
            </shape>
        </inset>
    </item>
</selector>
