<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_range_track" />
            <stroke android:width="0.5dp" android:color="@color/widget_range_track_border" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <!-- 智能座舱极光双色微晶流光渐变：零跑蓝 #0066FF ➔ 极光绿 @color/energy_green ➔ #00E676 -->
                <gradient
                    android:type="linear"
                    android:angle="0"
                    android:startColor="#0066FF"
                    android:centerColor="@color/energy_green"
                    android:endColor="#00E676" />
                <corners android:radius="2dp" />
            </shape>
        </clip>
    </item>
</layer-list>
