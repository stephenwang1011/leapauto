<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <inset android:insetLeft="4dp" android:insetTop="4dp" android:insetRight="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <solid android:color="#4DFF9800" />
                <stroke android:width="1dp" android:color="#80FF9800" />
                <corners android:radius="14dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="4dp" android:insetTop="4dp" android:insetRight="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <solid android:color="#2EFF9800" />
                <stroke android:width="0.8dp" android:color="#66FF9800" />
                <corners android:radius="14dp" />
            </shape>
        </inset>
    </item>
</selector>
