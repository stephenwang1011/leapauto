<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_range_track" />
            <stroke android:width="0.5dp" android:color="@color/widget_range_track_border" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <!-- 智能座舱极低电量警示微晶流光渐变：深红 #E53935 ➔ 危险红 @color/widget_range_critical ➔ #FF5252 -->
                <gradient
                    android:type="linear"
                    android:angle="0"
                    android:startColor="#E53935"
                    android:centerColor="@color/widget_range_critical"
                    android:endColor="#FF5252" />
                <corners android:radius="2dp" />
            </shape>
        </clip>
    </item>
</layer-list>
