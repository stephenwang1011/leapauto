<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. 315° 座舱黑曜微晶磨砂底盘 (#252D3D 至 #131720) -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0.00" android:color="#2B3448" />
                <item android:offset="0.45" android:color="#1F2634" />
                <item android:offset="1.00" android:color="#12161F" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 2. 45° 零跑科技蓝与极光微晶光晕层 (增加座舱深邃通透感) -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="76"
                android:centerY="32"
                android:gradientRadius="64">
                <item android:offset="0.00" android:color="#330066FF" />
                <item android:offset="0.55" android:color="#1400C853" />
                <item android:offset="1.00" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3. 微晶外圈高光切线网格 (0.8dp 晶透切角) -->
    <path
        android:pathData="M54,14 L88,34 L88,74 L54,94 L20,74 L20,34 Z"
        android:strokeWidth="0.8"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="20"
                android:startY="14"
                android:endX="88"
                android:endY="94">
                <item android:offset="0.00" android:color="#4DFFFFFF" />
                <item android:offset="0.50" android:color="#1AFFFFFF" />
                <item android:offset="1.00" android:color="#0DFFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
