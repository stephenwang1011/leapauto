<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <inset android:insetLeft="4dp" android:insetTop="4dp" android:insetRight="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <gradient
                    android:type="linear"
                    android:angle="315"
                    android:startColor="#B3E8E8E8"
                    android:endColor="#99D4D4D4" />
                <stroke
                    android:width="0.5dp"
                    android:color="#B3FFFFFF" />
                <corners android:radius="18dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="4dp" android:insetTop="4dp" android:insetRight="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <gradient
                    android:type="linear"
                    android:angle="315"
                    android:startColor="#59FFFFFF"
                    android:endColor="#33F0F0F0" />
                <stroke
                    android:width="0.5dp"
                    android:color="#80FFFFFF" />
                <corners android:radius="18dp" />
            </shape>
        </inset>
    </item>
</selector>
