<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#4D383838"
                android:endColor="#4D222222" />
            <stroke
                android:width="0.5dp"
                android:color="#26FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#1A383838"
                android:endColor="#12202020" />
            <stroke
                android:width="0.5dp"
                android:color="#1FFFFFFF" />
        </shape>
    </item>
</selector>
