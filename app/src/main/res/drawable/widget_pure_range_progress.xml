<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_range_track" />
            <stroke android:width="0.5dp" android:color="@color/widget_range_track_border" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <!-- 正常电量使用由深至浅的绿色渐变。 -->
                <gradient
                    android:type="linear"
                    android:angle="0"
                    android:startColor="#008F3D"
                    android:centerColor="@color/widget_range_good"
                    android:endColor="#00E676" />
                <corners android:radius="2dp" />
            </shape>
        </clip>
    </item>
</layer-list>
