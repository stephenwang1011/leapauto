<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_range_track" />
            <stroke android:width="0.5dp" android:color="@color/widget_range_track_border" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <!-- 智能座舱暖阳微晶流光渐变：暖橙 #FF9800 ➔ 预警金 @color/widget_range_warning ➔ #FFB74D -->
                <gradient
                    android:type="linear"
                    android:angle="0"
                    android:startColor="#FF9800"
                    android:centerColor="@color/widget_range_warning"
                    android:endColor="#FFB74D" />
                <corners android:radius="2dp" />
            </shape>
        </clip>
    </item>
</layer-list>
