<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <inset android:insetLeft="4dp" android:insetTop="4dp" android:insetRight="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <gradient
                    android:type="linear"
                    android:angle="315"
                    android:startColor="#B3383838"
                    android:endColor="#B3222222" />
                <stroke
                    android:width="0.5dp"
                    android:color="#3DFFFFFF" />
                <corners android:radius="18dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="4dp" android:insetTop="4dp" android:insetRight="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <gradient
                    android:type="linear"
                    android:angle="315"
                    android:startColor="#66404040"
                    android:endColor="#66282828" />
                <stroke
                    android:width="0.5dp"
                    android:color="#20FFFFFF" />
                <corners android:radius="18dp" />
            </shape>
        </inset>
    </item>
</selector>
