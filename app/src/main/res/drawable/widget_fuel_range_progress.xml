<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_range_track" />
            <stroke android:width="0.5dp" android:color="@color/widget_range_track_border" />
            <corners android:radius="2.25dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <!-- 智能座舱燃油琥珀暖金微晶流光渐变：琥珀橙 #FF9800 ➔ 暖金 #FFC107 -->
                <gradient
                    android:type="linear"
                    android:angle="0"
                    android:startColor="#FF9800"
                    android:endColor="#FFC107" />
                <corners android:radius="2.25dp" />
            </shape>
        </clip>
    </item>
</layer-list>
