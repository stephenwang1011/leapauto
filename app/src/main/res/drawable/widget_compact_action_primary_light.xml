<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <inset android:insetLeft="4dp" android:insetTop="4dp" android:insetRight="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <solid android:color="#330066FF" />
                <stroke android:width="0.5dp" android:color="#660066FF" />
                <corners android:radius="18dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="4dp" android:insetTop="4dp" android:insetRight="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <solid android:color="#1A0066FF" />
                <stroke android:width="0.5dp" android:color="#4D0066FF" />
                <corners android:radius="18dp" />
            </shape>
        </inset>
    </item>
</selector>
