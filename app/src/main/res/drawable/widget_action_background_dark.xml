<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#F22E3748"
                android:endColor="#F2181F2A" />
            <stroke
                android:width="0.5dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#D9333E52"
                android:endColor="#D91D2430" />
            <stroke
                android:width="0.5dp"
                android:color="#26FFFFFF" />
        </shape>
    </item>
</selector>
