<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#80383838"
                android:endColor="#80222222" />
            <stroke
                android:width="0.5dp"
                android:color="#2DFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#40404040"
                android:endColor="#40282828" />
            <stroke
                android:width="0.5dp"
                android:color="#1AFFFFFF" />
        </shape>
    </item>
</selector>
